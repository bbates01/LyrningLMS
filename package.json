{
  "name": "lyrning-lms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "bash dev.sh",
    "dev:both": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch backend/server.ts",
    "dev:frontend": "cd frontend && vite",
    "build": "cd frontend && vite build",
    "preview": "cd frontend && vite preview",
    "start": "npm run db:init && node --import tsx backend/server.ts",
    "db:init": "node --import tsx backend/db/init-db.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "lucide-react": "^0.563.0",
    "multer": "^1.4.5-lts.2",
    "openai": "^4.73.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.5.207",
    "pg": "^8.12.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.22",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.19.11",
    "@types/pg": "^8.11.6",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
